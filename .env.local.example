# .env.local.example
# Cópia este arquivo para .env.local e preencha as variáveis conforme necessário

# Configuração de Ambiente
NODE_ENV=production

# URL Base (use em production para URLs absolutas)
# VITE_APP_URL=https://seu-dominio.com/app-ip-genius

# Service Worker (para desenvolvimento, deixar vazio para usar padrão)
# VITE_SW_DEV=false

# Modo de Debug (apenas desenvolvimento)
# VITE_DEBUG=false
